{
  "name": "digital-asset-manager",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "image-service",
    "video-service",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint \"backend/**/*.{ts,tsx}\" \"frontend/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:back": "eslint backend --max-warnings=0",
    "lint:front": "eslint \"frontend/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:image": "eslint \"image-service/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:packages": "eslint packages --max-warnings=0",
    "lint:video": "eslint \"video-service/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:all": "npm run lint:back && npm run lint:front && npm run lint:image && npm run lint:packages && npm run lint:video",
    "lint:fix": "eslint 'backend/**/*.{ts,tsx}' 'frontend/**/*.{ts,tsx}' --fix",
    "format": "prettier --write \"{frontend,backend}/**/*.{js,jsx,ts,tsx,mjs,cjs}\"",
    "clean:back": "npm run clean -w backend",
    "clean:front": "npm run clean -w frontend",
    "clean:image": "npm run clean -w image-service",
    "clean:packages": "npm run clean -w packages",
    "clean:video": "npm run clean -w video-service",
    "clean": "npm run clean:packages && npm run clean:back && npm run clean:image && npm run clean:video && npm run clean:front",
    "dev:back": "npm run dev -w backend",
    "dev:front": "npm run dev -w frontend",
    "dev:image": "npm run dev -w image-service",
    "dev:packages": "npm run dev -w packages",
    "dev:video": "npm run dev -w video-service",
    "build:back": "npm run build -w backend",
    "build:front": "npm run build -w frontend",
    "build:image": "npm run build -w image-service",
    "build:packages": "npm run build -w packages",
    "build:video": "npm run build -w video-service",
    "build": "npm run build:packages && npm run build:back && npm run build:image && npm run build:video && npm run build:front",
    "start:back": "npm run start -w backend",
    "start:front": "npm run start -w frontend",
    "start:image": "npm run start -w image-service",
    "start:packages": "npm run start -w packages",
    "start:video": "npm run start -w video-service",
    "test": "npm run test -w backend"
  },
  "lint-staged": {
    "backend/**/*.{js,mjs,cjs,ts}": [
      "npx eslint --max-warnings=0",
      "npx prettier --check"
    ],
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "npx eslint --max-warnings=0",
      "npx prettier --check"
    ],
    "packages/**/*.{js,jsx,ts,tsx}": [
      "npx eslint --max-warnings=0",
      "npx prettier --check"
    ],
    "image-service/**/*.{js,jsx,ts,tsx}": [
      "npx eslint --max-warnings=0",
      "npx prettier --check"
    ],
    "video-service/**/*.{js,jsx,ts,tsx}": [
      "npx eslint --max-warnings=0",
      "npx prettier --check"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "axios": "^1.13.5"
  }
}
